{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Configurable Discord bot built with discord.js and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "tsx test/run-all.ts",
    "sync-badge-emojis": "tsx scripts/sync-badge-emojis.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.16.3",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mongodb": "^6.10.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.6",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2"
  }
}
